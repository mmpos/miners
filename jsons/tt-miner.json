{
  "name": "TT-Miner",
  "project_id": {
    "linux": "74",
    "windows": "64"
  },
  "executables": {
    "windows": "TT-Miner.exe",
    "linux": "TT-Miner"
  },
  "pool_protocol": {
    "tcp": "stratum+tcp://",
    "tls": "stratum+ssl://"
  },
  "arguments": "$ALGO -luck -P %pool_protocol%%user%:%password%@%pool_server%:%pool_port% --api-bind 127.0.0.1:%api_port%",
  "dual_arguments": "$ALGO -luck -P %pool_protocol%%user%:%password%@%pool_server%:%pool_port% $SECONDARY_ALGO --api-bind 127.0.0.1:%api_port%",
  "multi_coin": true,
  "platforms": [
    "nvidia"
  ],
  "api_protocols": [
    "tt-miner"
  ],
  "api_port": 4028,
  "coins": {
    "XEL": "-c XEL",
    "RTM": "-c RTM",
    "SPR": "-c SPR",
    "KCN": "-a flex",
    "NEOX": "-c NEOX",
    "MEWC": "-c MEWC",
    "ALPH": "-c ALPH",
    "EVR": "-c EVR",
    "RXD": "-c RXD",
    "ETH": "-c ETH",
    "ETC": "-c ETC",
    "UBQ": "-c UBQ",
    "SERO": "-c SERO",
    "ZANO": "-c ZANO",
    "RVN": "-c RVN",
    "IRON": "-c IRON"
  },
  "secondary_coins": {
    "ALPH": {
      "coins": [
        "ETH",
        "ETC",
        "UBQ",
        "IRON"
      ],
      "value": "-cALT ALPH -PALT %pool_protocol:ALPH%%user:ALPH%:%password:ALPH%@%pool_server:ALPH%:%pool_port:ALPH%"
    },
    "RXD": {
      "coins": [
        "ETH",
        "ETC",
        "UBQ",
        "IRON"
      ],
      "value": "-cALT RXD -PALT %pool_protocol:RXD%%user:RXD%:%password:RXD%@%pool_server:RXD%:%pool_port:RXD%"
    }
  },
  "override_platforms": [
    {
      "coins": [
        "XEL",
        "SPR",
        "KCN"
      ],
      "values": [
        "cpu_amd",
        "cpu_intel"
      ]
    }
  ],
  "override_pool_protocol": [
    {
      "coins": [
        "IRON"
      ],
      "value": {
        "tcp": "",
        "tls": "ssl://"
      }
    }
  ]
}
