{
  "name": "kawpowminer",
  "project_id": {
    "linux": "95",
    "windows": "96"
  },
  "executables": {
    "windows": "kawpowminer.exe",
    "linux": "kawpowminer"
  },
  "pool_protocol": {
    "tcp": "stratum+tcp://",
    "tls": "stratum+tls://"
  },
  "arguments": "$ALGO $VARIANTS --report-hashrate --HWMON 0 -P %pool_protocol%%user%:%password%@%pool_server%:%pool_port% --api-bind 127.0.0.1:%api_port% --cuda-grid-size 4096 --noeval",
  "platforms": [
    "nvidia",
    "amd_adl",
    "amd_sysfs"
  ],
  "api_protocols": [
    "claymore-ethash-v1",
    "ethminer"
  ],
  "api_port": 3333,
  "coins": {
    "RVN": "",
    "NEOX": ""
  },
  "variants": [
    {
      "coins": [
        "RVN",
        "NEOX"
      ],
      "arguments": {
        "amd": "-G",
        "nvidia": "-U"
      },
      "platforms": {
        "amd": [
          "amd_adl",
          "amd_sysfs"
        ],
        "nvidia": [
          "nvidia"
        ]
      }
    }
  ]
}
