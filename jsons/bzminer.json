{
  "name": "BZMiner",
  "project_id": {
    "linux": "115",
    "windows": "116"
  },
  "executables": {
    "windows": "bzminer.exe",
    "linux": "bzminer"
  },
  "pool_protocol": {
    "tcp": "stratum+tcp://",
    "tls": "stratum+ssl://"
  },
  "arguments": "$ALGO -p %pool_protocol%%pool_server%:%pool_port% -w %wallet_address% -r %rig_name% --http_enabled 1 --http_port %api_port% --nc 1",
  "multi_coin": true,
  "platforms": [
    "nvidia",
    "amd_adl",
    "amd_sysfs",
    "intel_sysfs"
  ],
  "api_protocols": [
    "bzminer"
  ],
  "api_port": 4014,
  "coins": {
    "ETH": "-a ethash",
    "ETC": "-a etchash",
    "WART": "-a warthog",
    "DCR": "-a decred",
    "DNX": "-a dynex",
    "CLORE": "-a clore",
    "XNA": "-a nexa",
    "IRON": "-a fishhash",
    "ALPH": "-a alph",
    "RXD": "-a radiant",
    "RVN": "-a rvn",
    "KAS": "-a kaspa",
    "KLS": "-a karlsen",
    "ERG": "-a ergo",
    "NEOX": "-a neoxa"
  }
}
