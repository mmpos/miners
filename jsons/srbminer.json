{
  "name": "SRB Miner",
  "project_id": {
    "linux": "92",
    "windows": "44"
  },
  "executables": {
    "windows": "SRBMiner-MULTI.exe",
    "linux": "SRBMiner-MULTI"
  },
  "pool_protocol": {
    "tcp": "",
    "tls": "stratum+tcps://"
  },
  "arguments": "$VARIANTS $ALGO --pool %pool_protocol%%pool_server%:%pool_port% --wallet %user% --password %password% --log-file /dev/null --api-enable --api-port %api_port%",
  "dual_arguments": "$VARIANTS $ALGO --pool %pool_protocol%%pool_server%:%pool_port% --wallet %user% --password %password% $SECONDARY_ALGO --log-file /dev/null --api-enable --api-port %api_port%",
  "multi_coin": true,
  "platforms": [
    "amd_sysfs",
    "amd_adl",
    "nvidia",
    "intel_sysfs"
  ],
  "api_protocols": [
    "srbminer"
  ],
  "api_port": 4028,
  "coins": {
    "KAS": "--disable-cpu --algorithm kaspa",
    "HTN": "--disable-cpu --algorithm hoohash",
    "XTM": "--disable-cpu --algorithm sha3x",
    "MBC": "--disable-gpu --algorithm yespower2b",
    "QUAI": "--disable-cpu --algorithm progpow_quai",
    "CLORE": "--disable-cpu --algorithm kawpow",
    "ZANO": "--disable-cpu --algorithm progpow_zano",
    "EVR": "--disable-cpu --algorithm evrprogpow",
    "TLS": "--disable-cpu --algorithm progpow_telestai",
    "RTM": "---disable-cpu -algorithm ghostrider",
    "MEWC": "--disable-cpu --algorithm meowpow",
    "KCN": "--disable-gpu --algorithm flex",
    "XEL": "--disable-gpu --algorithm xelishashv2",
    "VISH": "--disable-gpu --algorithm yespower",
    "BIT": "--disable-gpu --algorithm aurum",
    "PYI": "--disable-cpu --algorithm pyrinhashv2",
    "KLS": "--disable-cpu --algorithm karlsenhashv2",
    "RXD": "--disable-cpu --algorithm sha512_256d_radiant",
    "RVN": "--disable-cpu --algorithm kawpow",
    "NEOX": "--disable-cpu --algorithm kawpow",
    "ALPH": "--disable-cpu --algorithm blake3_alephium",
    "XMR": "--disable-gpu --algorithm randomx",
    "QRL": "--disable-gpu --algorithm randomx",
    "ZEPH": "--disable-gpu --algorithm randomx",
    "SAL": "--disable-gpu --algorithm randomx",
    "CCX": "--disable-cpu --algorithm cryptonight_gpu",
    "RYO": "--disable-cpu --algorithm cryptonight_gpu",
    "VRSC": "--algorithm verushash",
    "ERG": "--algorithm autolykos2",
    "IRON": "--disable-cpu --algorithm fishhash",
    "PLSR": "--algorithm curvehash",
    "VTC": "--algorithm verthash",
    "XLA": "--disable-gpu --algorithm panthera",
    "LOKI": "--disable-gpu --algorithm randomxl",
    "HNS": "--disable-cpu --algorithm bl2bsha3",
    "BBC": "--disable-cpu --algorithm cryptonight_bbc",
    "XHV": "--disable-cpu --algorithm cryptonight_xhv",
    "TRTL": "--disable-cpu --algorithm argon2id_chukwa2",
    "KDA": "--disable-cpu --algorithm kadena",
    "CKB": "--disable-cpu --algorithm eaglesong",
    "ETH": "--disable-cpu --algorithm ethash",
    "ETC": "--disable-cpu --algorithm etchash",
    "UBQ": "--disable-cpu --algorithm ubqhash",
    "FIRO": "--disable-cpu --algorithm firopow",
    "DCR": "--disable-cpu --algorithm blake3_decred"
  },
  "secondary_coins": {
    "XTM": {
      "coins": [
        "ERG",
        "ETC",
        "KLS",
        "IRON",
        "UBQ"
      ],
      "value": "--algorithm sha3x --pool %pool_protocol:XTM%%pool_server:XTM%:%pool_port:XTM% --wallet %user:XTM% --password %password:XTM%"
    }
  },
  "override_arguments": [
    {
      "coins": [
        "ETH",
