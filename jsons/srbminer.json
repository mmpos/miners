{
  "name": "SRB Miner",
  "project_id": {
    "linux": "92",
    "windows": "44"
  },
  "executables": {
    "windows": "SRBMiner-MULTI.exe",
    "linux": "SRBMiner-MULTI"
  },
  "pool_protocol": {
    "tcp": "",
    "tls": "stratum+tcps://"
  },
  "arguments": "$ALGO $VARIANTS --pool %pool_protocol%%pool_server%:%pool_port% --wallet %wallet_address% --worker %rig_name%%miner_id% --password %password% --log-file /dev/null --api-enable --api-port %api_port%",
  "multi_coin": true,
  "platforms": [
    "amd_sysfs",
    "amd_adl",
    "nvidia",
    "intel_sysfs"
  ],
  "api_protocols": [
    "srbminer"
  ],
  "api_port": 4028,
  "coins": {
    "KAS": "--algorithm kaspa --disable-cpu",
    "HTN": "--algorithm hoohash --disable-cpu",
    "XTM": "--algorithm sha3x --disable-cpu",
    "CPAY": "--algorithm cryptixhash --disable-cpu",
    "MBC": "--algorithm yespower2b --disable-gpu",
    "QUAI": "--algorithm progpow_quai --disable-cpu",
    "CLORE": "--algorithm kawpow --disable-cpu",
    "ZANO": "--algorithm progpow_zano --disable-cpu",
    "EVR": "--algorithm evrprogpow --disable-cpu",
