    "ZEPH": "--algorithm randomx --disable-gpu",
    "SAL": "--algorithm randomx --disable-gpu",
    "CCX": "--algorithm cryptonight_gpu --disable-cpu",
    "RYO": "--algorithm cryptonight_gpu --disable-cpu",
    "VRSC": "--algorithm verushash",
    "ERG": "--algorithm autolykos2",
    "IRON": "--algorithm fishhash --disable-cpu",
    "PLSR": "--algorithm curvehash",
    "VTC": "--algorithm verthash",
    "XLA": "--algorithm panthera --disable-gpu",
    "LOKI": "--algorithm randomxl --disable-gpu",
    "HNS": "--algorithm bl2bsha3 --disable-cpu",
    "BBC": "--algorithm cryptonight_bbc --disable-cpu",
    "XHV": "--algorithm cryptonight_xhv --disable-cpu",
    "TRTL": "--algorithm argon2id_chukwa2 --disable-cpu",
    "KDA": "--algorithm kadena --disable-cpu",
    "CKB": "--algorithm eaglesong --disable-cpu",
    "ETH": "--algorithm ethash --disable-cpu",
    "ETC": "--algorithm etchash --disable-cpu",
    "UBQ": "--algorithm ubqhash --disable-cpu",
    "FIRO": "--algorithm firopow --disable-cpu",
    "DCR": "--algorithm blake3_decred --disable-cpu"
