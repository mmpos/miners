{
  "name": "teamredminer",
  "project_id": {
    "linux": "17",
    "windows": "49"
  },
  "executables": {
    "windows": "teamredminer.exe",
    "linux": "teamredminer"
  },
  "pool_protocol": {
    "tcp": "stratum+tcp://",
    "tls": "stratum+ssl://"
  },
  "arguments": "$ALGO -o %pool_protocol%%pool_server%:%pool_port% -u %user% -p %password% --api_listen=127.0.0.1:%api_port% --bus_reorder --short_stats",
  "multi_coin": true,
  "platforms": [
    "amd_adl",
    "amd_sysfs"
  ],
  "api_protocols": [
    "sgminer_plain",
    "teamredminer"
  ],
  "api_port": 4028,
  "coins": {
    "TON": "-a ton",
    "KAS": "-a kas",
    "ALPH": "-a alph",
    "ABEL": "-a abel",
    "ERG": "-a autolykos2",
    "IRON": "-a fishhash",
    "VTC": "-a verthash",
    "FIRO": "-a firopow",
    "NIM": "-a nimiq",
    "ETH": "-a ethash",
    "ETC": "-a etchash",
    "UPX": "-a cnv8_upx2",
    "LUX": "-a phi2",
    "GTM": "-a lyra2z",
    "TRTL": "-a trtl_chukwa2",
    "XTL": "-a cnv8_half",
    "MSR": "-a cnv8_half",
    "GRFT": "-a cnv8_rwz",
    "XHV": "-a cn_haven",
    "GRV": "-a x16r",
    "XMN": "-a x16r",
    "RVN": "-a kawpow",
    "AIPG": "-a kawpow",
    "CLORE": "-a kawpow",
    "XNA": "-a kawpow",
    "NEOX": "-a kawpow",
    "PGN": "-a x21s",
    "GIN": "-a x16rt",
    "GRIN": "-a cuckatoo31_grin",
    "MWC": "-a cuckatoo31_grin"
  },
  "secondary_coins": {
    "ALPH": {
      "coins": [
        "ERG",
        "ETC",
        "IRON"
      ],
      "arguments": "--alph -o %pool_protocol:ALPH%%pool_server:ALPH%:%pool_port:ALPH% -u %user:ALPH% -p %password:ALPH% --alph_end"
    },
    "KAS": {
      "coins": [
        "ERG",
        "ETC",
        "IRON"
      ],
      "arguments": "--kas -o %pool_protocol:KAS%%pool_server:KAS%:%pool_port:KAS% -u %user:KAS% -p %password:KAS% --kas_end"
    }
  },
  "override_arguments": [
    {
      "coins": [
        "NIM"
      ],
      "value": "$ALGO -o %pool_protocol%%pool_server%:%pool_port% -u \"%wallet_address%\" -p %password% --nimiq_worker=%rig_name%%miner_id% --api_listen=127.0.0.1:%api_port% --bus_reorder --short_stats --watchdog_script=/opt/mmp/sbin/reboot.sh"
    }
  ],
  "override_platforms": [
    {
      "coins": [
        "KAS",
        "ALPH",
        "ETH",
        "ETC"
      ],
      "values": [
        "amd_adl",
        "amd_sysfs",
        "fpga_vu9p",
        "fpga_vu13p",
        "fpga_vu33p",
        "fpga_vu35p"
      ]
    }
  ]
}
