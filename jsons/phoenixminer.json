{
  "name": "PhoenixMiner",
  "project_id": {
    "linux": "15",
    "windows": "41"
  },
  "executables": {
    "windows": "PhoenixMiner.exe",
    "linux": "PhoenixMiner"
  },
  "pool_protocol": {
    "tcp": "",
    "tls": "ssl://"
  },
  "arguments": "$ALGO $VARIANTS -pool %pool_protocol%%pool_server%:%pool_port% -wal %user% -pass %password% -log 0 -rmode 2 -cdmport -%api_port%",
  "platforms": [
    "nvidia",
    "amd_adl",
    "amd_sysfs"
  ],
  "api_protocols": [
    "claymore-ethash-v1",
    "claymore-ethash-v2"
  ],
  "api_port": 3333,
  "coins": {
    "ETH": "",
    "ETC": "-coin etc",
    "UBQ": "-coin ubq",
    "BCI": "-coin bci"
  },
  "variants": [
    {
      "coins": [
        "ETH",
        "ETC"
      ],
      "arguments": {
        "amd": "-amd",
        "nvidia": "-nvidia"
      },
      "platforms": {
        "amd": [
          "amd_adl",
          "amd_sysfs"
        ],
        "nvidia": [
          "nvidia"
        ]
      }
    }
  ]
}
