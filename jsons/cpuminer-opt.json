    "ccminer"
  ],
  "api_port": 4069,
  "coins": {
    "LUX": "-a phi2",
    "MBC": "-a power2b",
    "VISH": "-a yespower",
    "XDNA": "-a hex",
    "GRV": "-a x16rv2",
    "XMN": "-a x16rv2",
    "FTC": "-a neoscrypt",
    "PXC": "-a neoscrypt",
    "UFO": "-a neoscrypt"
  }
}
