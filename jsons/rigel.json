{
  "name": "Rigel",
  "project_id": {
    "linux": "133",
    "windows": "132"
  },
  "executables": {
    "windows": "rigel.exe",
    "linux": "rigel"
  },
  "pool_protocol": {
    "tcp": "stratum+tcp://",
    "tls": "stratum+ssl://"
  },
  "arguments": "$ALGO --no-tui -o %pool_protocol%%pool_server%:%pool_port% -u %wallet_address% -w %rig_name%%miner_id% --api-bind 127.0.0.1:%api_port%",
  "multi_coin": true,
  "platforms": [
    "nvidia"
  ],
  "api_protocols": [
    "rigel"
  ],
  "api_port": 7500,
  "coins": {
    "RVN": "-a kawpow --coin rvn",
    "ZANO": "-a progpowz",
    "XTM": "-a sha3x",
    "QUAI": "-a quai",
    "TON": "-a sha256ton",
    "ABEL": "-a abelian",
    "AIPG": "-a kawpow --coin aipg",
    "NEOX": "-a kawpow --coin neox",
    "KLS": "-a karlsenhashv2",
    "PYI": "-a pyrinhashv2",
    "CLORE": "-a kawpow --coin clore",
    "XNA": "-a kawpow --coin xna",
    "CFX": "-a octopus",
    "ETH": "-a ethash",
    "ERG": "-a autolykos2",
    "RXD": "-a sha512256d",
    "ETC": "-a etchash",
    "NEXA": "-a nexapow",
    "KAS": "-a kheavyhash",
    "ALPH": "-a alephium",
    "IRON": "-a fishhash",
    "XEL": "-a xelishashv2"
  },
  "secondary_coins": {
    "XTM": {
      "coins": [
        "CFX",
        "ERG",
        "ETH",
        "ETC",
        "KLS",
        "IRON"
      ],
      "arguments": "-a $ALGO+sha3x --no-tui -o [1]%pool_protocol%%pool_server%:%pool_port% -u [1]%wallet_address% -o [2]%pool_protocol:XTM%%pool_server:XTM%:%pool_port:XTM% -u [2]%wallet_address:XTM% -w %rig_name%%miner_id% --api-bind 127.0.0.1:%api_port%"
    },
    "ALPH": {
      "coins": [
        "CFX",
        "ERG",
        "ETH",
        "ETC",
        "KLS",
        "IRON"
      ],
      "arguments": "-a $ALGO+alephium --no-tui -o [1]%pool_protocol%%pool_server%:%pool_port% -u [1]%wallet_address% -o [2]%pool_protocol:ALPH%%pool_server:ALPH%:%pool_port:ALPH% -u [2]%wallet_address:ALPH% -w %rig_name%%miner_id% --api-bind 127.0.0.1:%api_port%"
    },
    "RXD": {
      "coins": [
        "CFX",
        "ERG",
        "ETH",
        "ETC",
        "KLS",
        "IRON"
      ],
      "arguments": "-a $ALGO+sha512256d --no-tui -o [1]%pool_protocol%%pool_server%:%pool_port% -u [1]%wallet_address% -o [2]%pool_protocol:RXD%%pool_server:RXD%:%pool_port:RXD% -u [2]%wallet_address:RXD% -w %rig_name%%miner_id% --api-bind 127.0.0.1:%api_port%"
    }
  },
  "override_pool_protocol": [
    {
      "coins": [
        "ETH",
        "ETC"
      ],
      "value": {
        "tcp": "ethproxy+tcp://",
        "tls": "ethproxy+ssl://"
      }
    }
  ]
}
